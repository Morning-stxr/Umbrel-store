# -- Nextuath portion --
NEXT_PUBLIC_ENABLE_NEXT_AUTH=1

## run 'openssl rand -base64 32' and paste results here
NEXT_AUTH_SECRET=

## NEXTAUTH_URL by default runs off of lobe port
NEXTAUTH_URL=http://umbrel.local:3210

# -- Postgres DB portion --
## DATABASE_URL usually runs on postgress instance port 5432
DATABASE_URL=http://umbrel.local:5432

## run 'openssl rand -base64 32' and paste results here
KEY_VAULTS_SECRET=

# -- S3 Storage portion --
## S3 keys (cloudflare and tencent have guides on docs) (must make an api key)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

## S3 bucket name (can be found)
S3_BUCKET=

## Url to bucket endpoint (for cloudflare ends in r2.cloudflarestorage.com)
S3_ENDPOINT=

## Public access domain for bucket
S3_PUBLIC_DOMAIN=

## Bucket Region, such as us-west-1. Generally not required, but some service providers may need it.
## S3_REGION=us-west-1
